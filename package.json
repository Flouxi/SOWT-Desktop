{
  "name": "sowt-desktop",
  "version": "0.0.29",
  "description": "SOWT personal voice assistant for Mac and Windows",
  "private": true,
  "author": "SOWT",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.sowt.desktop",
    "productName": "SOWT",
    "artifactName": "SOWT-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "files": ["main.cjs", "policy.cjs", "offline.html", "assets/icon.png", "package.json"],
    "directories": {"output": "dist"},
    "mac": {
      "target": [{"target": "dmg", "arch": ["arm64", "x64"]}],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "identity": null,
      "extendInfo": {"NSMicrophoneUsageDescription": "SOWT uses your microphone only when you start a voice conversation."}
    },
    "dmg": {"sign": false},
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "icon": "assets/icon.png"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": false},
    "publish": null
  }
}
